# SmartStorageService — market data placement
#
# Copy the lines you want into your own .env (which is gitignored). Every
# setting defaults to OFF, so a clone with none of this set behaves exactly
# the way the project always has: everything local, nothing reaching for a
# network.
#
# WHY THIS FILE HAS NO ACCOUNT NUMBERS IN IT
# The AWS profile and bucket are read from the environment precisely so that
# no developer's AWS identity is committed. Point MARKET_DATA_S3_PROFILE at a
# profile in your own ~/.aws/credentials and MARKET_DATA_S3_BUCKET at a bucket
# in your own account, and the same code serves you.

# --- market data (OHLCV, news) -------------------------------------------
# Off: read and write locally, exactly as before.
# On:  local stays authoritative and is written first; a copy is synced to S3.
MARKET_DATA_S3_ENABLED=0

# --- account data (wallet, positions, trade outcomes) --------------------
# Deliberately separate from the switch above and expected to stay 0 for a
# local deployment. Market data is public and replaceable; account data is
# neither. Turning this on is a different decision with different stakes.
ACCOUNT_DATA_S3_ENABLED=0

# --- where remote data goes ----------------------------------------------
# Create the bucket in your own account, block public access, and let the
# lifecycle rules tier it (see aws/smart_storage/bucket_lifecycle.json).
MARKET_DATA_S3_BUCKET=
MARKET_DATA_S3_PROFILE=
MARKET_DATA_S3_REGION=us-east-1

# --- local footprint ------------------------------------------------------
# The ceiling above which eviction is CONSIDERED. Eviction only ever removes
# a file confirmed to exist in S3, so the worst case of setting this low is a
# slower read, never a missing one. With remote disabled nothing is ever
# evicted: every local file is the only copy.
SMART_STORAGE_LOCAL_BUDGET_MB=4096

# --- the hot set ----------------------------------------------------------
# Bars per symbol that must stay resident for zero-latency reads. This is not
# a tuning knob so much as a measurement: it is what the trading loop reads
# each tick, so it is exactly what "no latency" costs.
#
# Measured on this deployment 2026-09-06:
#   26 active symbols x 60 bars x 217 bytes = 0.34 MB
# against 2914 MB of OHLCV on disk -- the hot set is 0.012% of the archive.
BOT_WINDOW_SIZE=60
